# Copy this file to .env and fill in your API keys.
# .env is gitignored and wired into the workspace container by
# `alcatrazer start` via `docker run --env-file`.
#
# Only keys defined here reach the container — host environment variables
# are never passed through blindly.

# --- LLM Authentication ---
#
# Primary method: Claude Code OAuth credentials are mounted read-only
# from ~/.claude/.credentials.json (wired by DockerPrison.start). This
# uses your existing Claude subscription (Pro, Max, Teams, Enterprise).
# No configuration needed here — it works automatically.
#
# Alternative: if you prefer API key auth (pay-per-use, separate billing),
# uncomment and fill in:
# ANTHROPIC_API_KEY=

# Optional: additional LLM providers
# OPENAI_API_KEY=
# MINIMAX_API_KEY=
